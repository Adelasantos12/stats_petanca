// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Match {
  id           String        @id @default(uuid())
  modality     String        // SINGLE, DOUBLES, TRIPLES
  targetPoints Int           @default(13)
  status       String        @default("IN_PROGRESS") // IN_PROGRESS, FINISHED
  endReason    String?       // TARGET_REACHED, TIME, MANUAL
  createdAt    DateTime      @default(now())
  endedAt      DateTime?
  teamAName    String
  teamBName    String
  players      MatchPlayer[]
  hands        Hand[]
  throws       Throw[]
}

model Player {
  id      String        @id @default(uuid())
  name    String
  matches MatchPlayer[]
  throws  Throw[]
}

model MatchPlayer {
  matchId  String
  playerId String
  teamSide String // A, B
  match    Match  @relation(fields: [matchId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@id([matchId, playerId])
}

model Hand {
  id          String  @id @default(uuid())
  matchId     String
  handNumber  Int
  status      String  @default("NORMAL") // NORMAL, CANCELED
  pointsTeam  String? // A, B
  pointsValue Int?
  match       Match   @relation(fields: [matchId], references: [id])
}

model Throw {
  id                 String   @id @default(uuid())
  matchId            String
  handNumber         Int
  teamSide           String   // A, B
  playerId           String
  throwType          String   // POINT, TIR
  effectivenessScore Int      // -2 to 2
  distanceD          Float?
  note               String?
  createdAt          DateTime @default(now())
  match              Match    @relation(fields: [matchId], references: [id])
  player             Player   @relation(fields: [playerId], references: [id])
}
